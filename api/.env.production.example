DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
# Ordinary Cloud Run configuration; use the existing Vercel hostname.
WEB_ORIGIN=https://YOUR_EXISTING_VERCEL_DOMAIN.vercel.app
CORS_ORIGINS=https://YOUR_EXISTING_VERCEL_DOMAIN.vercel.app,http://localhost:3100
# Ordinary configuration. GOOGLE_REDIRECT_URI must be replaced with the actual
# Cloud Run run.app URL after the first deployment.
GOOGLE_CLIENT_ID=REPLACE
GOOGLE_CLIENT_SECRET=REPLACE
GOOGLE_REDIRECT_URI=https://REPLACE_WITH_CLOUD_RUN_RUN_APP_URL/api/auth/google/callback
GNANI_API_KEY=REPLACE
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v3.0
GNANI_DEFAULT_VOICE=Shivani
META_API_KEY=REPLACE
NVIDIA_API_KEY=REPLACE
GROQ_API_KEY=REPLACE
OPENROUTER_API_KEY=REPLACE
R2_ACCOUNT_ID=REPLACE
R2_ACCESS_KEY_ID=REPLACE
R2_SECRET_ACCESS_KEY=REPLACE
R2_BUCKET_NAME=REPLACE
R2_ENDPOINT=https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
PORT=8080
UPLOAD_DIR=/tmp/twyn-uploads
ALLOW_DEV_LOGIN=0
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_MIN_SCORE=0.27
VECTOR_STORE=sql
RATE_LIMIT_PER_MIN=30
MAX_AUDIO_BYTES=8388608
MAX_IMAGE_BYTES=3145728
MAX_DOC_BYTES=10485760
MAX_TEXT_CHARS=1500
SESSION_DAYS=30
