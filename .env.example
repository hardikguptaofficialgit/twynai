DATABASE_URL=sqlite:///api/proxy.db
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v3.0
GNANI_DEFAULT_VOICE=Shivani
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
META_API_KEY=
META_MODEL=muse-spark-1.3
META_MONTHLY_BUDGET_USD=30
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_ORIGIN=http://localhost:3100
GOOGLE_REDIRECT_URI=http://localhost:8100/api/auth/google/callback
PORT=8100
UPLOAD_DIR=api/uploads
# Optional Neon S3-compatible object storage (when blank, uploads use UPLOAD_DIR)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-2
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
# web/.env.local: NEXT_PUBLIC_API_URL=http://localhost:8100
# Retrieval: fastembed model name, or "hash" for the offline fallback
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_MIN_SCORE=0.27
# sql (default, cosine in Python) or pgvector (interface stub)
VECTOR_STORE=sql
CORS_ORIGINS=*

# Hardening
ALLOW_DEV_LOGIN=1
RATE_LIMIT_PER_MIN=30
MAX_AUDIO_BYTES=8388608
MAX_DOC_BYTES=10485760
MAX_TEXT_CHARS=1500
