DATABASE_URL=sqlite:///api/proxy.db
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v3.0
GNANI_DEFAULT_VOICE=Shivani
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_ORIGIN=http://localhost:3100
UPLOAD_DIR=api/uploads
# web/.env.local: NEXT_PUBLIC_API_URL=http://localhost:8100
# Retrieval: fastembed model name, or "hash" for the offline fallback
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_MIN_SCORE=0.27
# sql (default, cosine in Python) or pgvector (interface stub)
VECTOR_STORE=sql
CORS_ORIGINS=*

# Hardening
ALLOW_DEV_LOGIN=1
RATE_LIMIT_PER_MIN=30
MAX_AUDIO_BYTES=8388608
MAX_DOC_BYTES=10485760
MAX_TEXT_CHARS=1500
